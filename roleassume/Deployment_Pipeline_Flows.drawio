ight="30" as="geometry"/></mxCell><mxCell id="gb" value="Before: old pipeline and WS2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="560" height="270" as="geometry"/></mxCell><mxCell id="bgh" value="&lt;b&gt;GitHub run&lt;/b&gt;&lt;br&gt;OIDC token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="160" height="80" as="geometry"/></mxCell><mxCell id="bcte" value="&lt;b&gt;AWSControlTowerExecution&lt;/b&gt;&lt;br&gt;in the target account&lt;br&gt;Control Tower’s own admin role; Control Tower’s guardrails exempt it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="270" height="120" as="geometry"/></mxCell><mxCell id="btx" value="One hop. The role ARN comes from a GitHub secret." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="520" height="40" as="geometry"/></mxCell><mxCell id="gn" value="Now: new pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="900" height="270" as="geometry"/></mxCell><mxCell id="ngh" value="&lt;b&gt;GitHub run&lt;/b&gt;&lt;br&gt;OIDC token, from a trusted GitHub org" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="160" height="80" as="geometry"/></mxCell><mxCell id="nroot" value="&lt;b&gt;Hop 1 · IMS Root&lt;/b&gt;&lt;br&gt;iamr-&amp;lt;account&amp;gt;-&amp;lt;env&amp;gt;-deploy&lt;br&gt;Its only permission: switch to the same role in one account" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="290" height="120" as="geometry"/></mxCell><mxCell id="nacct" value="&lt;b&gt;Hop 2 · target account&lt;/b&gt;&lt;br&gt;iamr-&amp;lt;account&amp;gt;-&amp;lt;env&amp;gt;-deploy&lt;br&gt;Does the deployment, under the guardrails, 1 hour at most" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1210" y="120" width="290" height="120" as="geometry"/></mxCell><mxCell id="ntx" value="Every job prints both roles and stops if either is wrong." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="860" height="40" as="geometry"/></mxCell><mxCell id="e0" value="one hop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bgh" target="bcte"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="hop 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ngh" target="nroot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="hop 2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="nroot" target="nacct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>