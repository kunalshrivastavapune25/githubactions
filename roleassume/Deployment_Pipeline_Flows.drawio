<mxfile><diagram id="page-1" name="New pipeline"><mxGraphModel dx="1480" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;New pipeline&lt;/b&gt; – latest_cft_deployment.yml" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="s" value="Drift check, change set, then keep or overwrite manual changes – for any CloudFormation stack in any of our 47 accounts. Run from GitHub › Actions › Run workflow." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="start" value="&lt;b&gt;Run workflow&lt;/b&gt;&lt;br&gt;Account (47 names) and region, folder and stack name, &lt;i&gt;Deploy&lt;/i&gt; and &lt;i&gt;Remove manual changes&lt;/i&gt; (both no)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="170" height="100" as="geometry"/></mxCell><mxCell id="prep" value="&lt;b&gt;Prepare&lt;/b&gt;&lt;br&gt;Signs in (hop 1, hop 2) and checks both roles. Finds the template. Checks the stack status" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="185" width="170" height="100" as="geometry"/></mxCell><mxCell id="dex" value="Stack exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="180" width="150" height="110" as="geometry"/></mxCell><mxCell id="drift" value="&lt;b&gt;Drift check&lt;/b&gt;&lt;br&gt;Information only: lists what was changed by hand, expected vs actual" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="650" y="185" width="170" height="100" as="geometry"/></mxCell><mxCell id="cs" value="&lt;b&gt;Change set&lt;/b&gt;&lt;br&gt;Drift-aware: manual changes it would undo, template changes, link to AWS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="185" width="170" height="100" as="geometry"/></mxCell><mxCell id="dch" value="Anything to change?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="150" height="110" as="geometry"/></mxCell><mxCell id="ddep" value="Deploy = yes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="180" width="150" height="110" as="geometry"/></mxCell><mxCell id="note" value="Manual change found? Listed as a &lt;b&gt;warning&lt;/b&gt;, and the run carries on" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="650" y="72" width="170" height="76" as="geometry"/></mxCell><mxCell id="enoch" value="&lt;b&gt;No changes&lt;/b&gt;&lt;br&gt;Ends cleanly, nothing is deployed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1070" y="72" width="170" height="70" as="geometry"/></mxCell><mxCell id="ewait" value="&lt;b&gt;Stops at the change set&lt;/b&gt;&lt;br&gt;A person reviews it in AWS and clicks Execute" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1280" y="72" width="170" height="70" as="geometry"/></mxCell><mxCell id="dundo" value="Would it undo manual changes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1285" y="335" width="160" height="120" as="geometry"/></mxCell><mxCell id="dep" value="&lt;b&gt;Deploy&lt;/b&gt;&lt;br&gt;Executes that same change set and follows the stack events" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1070" y="345" width="170" height="100" as="geometry"/></mxCell><mxCell id="done" value="&lt;b&gt;Deployed&lt;/b&gt;&lt;br&gt;A failed update rolls back on its own" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="345" width="170" height="100" as="geometry"/></mxCell><mxCell id="dflag" value="Remove manual changes = yes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1285" y="500" width="160" height="120" as="geometry"/></mxCell><mxCell id="stop" value="&lt;b&gt;Stop – not deployed&lt;/b&gt;&lt;br&gt;The Deploy job shows red. To keep the change, add it to the code and run again" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1280" y="675" width="170" height="90" as="geometry"/></mxCell><mxCell id="sgrp" value="Sign-in, repeated by every job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="820" height="175" as="geometry"/></mxCell><mxCell id="sgh" value="&lt;b&gt;GitHub run&lt;/b&gt;&lt;br&gt;OIDC token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="150" height="76" as="geometry"/></mxCell><mxCell id="sroot" value="&lt;b&gt;Hop 1 · IMS Root&lt;/b&gt;&lt;br&gt;iamr-&amp;lt;account&amp;gt;-&amp;lt;env&amp;gt;-deploy&lt;br&gt;can only switch to the same role in one account" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="502" width="240" height="96" as="geometry"/></mxCell><mxCell id="sacct" value="&lt;b&gt;Hop 2 · target account&lt;/b&gt;&lt;br&gt;iamr-&amp;lt;account&amp;gt;-&amp;lt;env&amp;gt;-deploy&lt;br&gt;does the deployment (1 hour at most)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="570" y="502" width="250" height="96" as="geometry"/></mxCell><mxCell id="stxt" value="Each job prints both roles and stops if either is wrong. The roles come from a table in the workflow, not from GitHub secrets. Deploying to IMS Root itself is one hop." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="604" width="780" height="36" as="geometry"/></mxCell><mxCell id="safe" value="&lt;b&gt;Also built in:&lt;/b&gt; one run per stack at a time · blocks busy or broken stacks · flags deletions and replacements · warns when run from an unmerged branch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="665" width="820" height="56" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="prep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prep" target="dex"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dex" target="drift"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="drift" target="cs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cs" target="dch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dch" target="ddep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dch" target="enoch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddep" target="ewait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ddep" target="dundo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dundo" target="dep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dundo" target="dflag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="yes – overwrite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dflag" target="dep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1155" y="560"/></Array></mxGeometry></mxCell><mxCell id="e12" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dflag" target="stop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="no – new stack, no drift check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dex" target="cs"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525" y="315"/><mxPoint x="945" y="315"/></Array></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;endArrow=none;" edge="1" parent="1" source="drift" target="note"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="hop 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sgh" target="sroot"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="hop 2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sroot" target="sacct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="WS2 DNS pipelines"><mxGraphModel dx="1300" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="830" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;WS2 DNS pipelines&lt;/b&gt; – ws2-dns-records-export.yml + ws2-dns-records-apply.yml" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="s" value="Bulk changes to DNS records only." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="900" height="24" as="geometry"/></mxCell><mxCell id="g1" value="Part 1 · Export: live DNS → Git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1240" height="190" as="geometry"/></mxCell><mxCell id="xs" value="&lt;b&gt;Run workflow&lt;/b&gt;&lt;br&gt;Pick the account and one zone, or all zones" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="170" height="90" as="geometry"/></mxCell><mxCell id="xd" value="All zones, outside sandbox?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="150" height="110" as="geometry"/></mxCell><mxCell id="xa" value="&lt;b&gt;Approval&lt;/b&gt;&lt;br&gt;A reviewer approves the export" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="170" height="90" as="geometry"/></mxCell><mxCell id="xe" value="&lt;b&gt;Export&lt;/b&gt;&lt;br&gt;Live records copied into one file per zone" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="170" height="90" as="geometry"/></mxCell><mxCell id="xp" value="&lt;b&gt;Pull Request&lt;/b&gt;&lt;br&gt;New branch and Pull Request created for you" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="170" height="90" as="geometry"/></mxCell><mxCell id="xm" value="&lt;b&gt;Edit, review, merge&lt;/b&gt;&lt;br&gt;Edit the record files, a reviewer approves, merge" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="170" height="90" as="geometry"/></mxCell><mxCell id="g2" value="Part 2 · Apply: Git → live DNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;arcSize=4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1240" height="300" as="geometry"/></mxCell><mxCell id="as" value="&lt;b&gt;Run workflow&lt;/b&gt;&lt;br&gt;Pick the zone; tick execute to change it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="170" height="90" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Preview&lt;/b&gt;&lt;br&gt;Compares the files with live DNS: adds, edits, deletes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="270" y="370" width="170" height="90" as="geometry"/></mxCell><mxCell id="ad1" value="Execute ticked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="150" height="110" as="geometry"/></mxCell><mxCell id="aonly" value="&lt;b&gt;Preview only&lt;/b&gt;&lt;br&gt;Nothing changes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="525" width="150" height="70" as="geometry"/></mxCell><mxCell id="ad2" value="Outside sandbox?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="670" y="360" width="150" height="110" as="geometry"/></mxCell><mxCell id="aa" value="&lt;b&gt;Gatekeeper approval&lt;/b&gt;&lt;br&gt;Someone approves first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="860" y="370" width="170" height="90" as="geometry"/></mxCell><mxCell id="ax" value="&lt;b&gt;Apply&lt;/b&gt;&lt;br&gt;Works the changes out again and writes them into Route 53" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1070" y="370" width="190" height="90" as="geometry"/></mxCell><mxCell id="adone" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;Live DNS matches the files" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="525" width="190" height="70" as="geometry"/></mxCell><mxCell id="gap1" value="&lt;b&gt;No manual-change alarm&lt;/b&gt; – a hand edit looks like any other change and is overwritten" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="400" height="60" as="geometry"/></mxCell><mxCell id="gap2" value="&lt;b&gt;Preview isn’t locked&lt;/b&gt; – apply works the changes out again; what runs isn’t pinned to the preview" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="460" y="640" width="400" height="60" as="geometry"/></mxCell><mxCell id="gap3" value="&lt;b&gt;Outside CloudFormation&lt;/b&gt; – no change set, no stack history, separate record files" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;align=left;spacingLeft=8;spacingRight=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="640" width="400" height="60" as="geometry"/></mxCell><mxCell id="sign" value="&lt;b&gt;Sign-in:&lt;/b&gt; one hop, with the role ARN from the GitHub secret DEPLOY_ROLE_ARNS_JSON, which is AWSControlTowerExecution (checked 31 Oct 2026)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="718" width="1240" height="40" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xs" target="xd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xd" target="xa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xa" target="xe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryD