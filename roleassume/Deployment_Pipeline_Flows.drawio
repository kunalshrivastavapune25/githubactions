</mxGraphModel></diagram><diagram id="page-3" name="Old pipeline"><mxGraphModel dx="1280" dy="480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Old pipeline&lt;/b&gt; – old-pipeline-firewall.yml" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="s" value="Direct deployment in one job. Kept only for FMS policies and rule groups, which AWS can’t drift-check." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="24" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;Run workflow&lt;/b&gt;&lt;br&gt;Type the stack name, folder and role name by hand" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="170" height="90" as="geometry"/></mxCell><mxCell id="of" value="&lt;b&gt;Find files&lt;/b&gt;&lt;br&gt;Template and settings from the chosen folder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="170" height="90" as="geometry"/></mxCell><mxCell id="od" value="Template over&lt;br&gt;50 KB?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="150" height="110" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;Upload to S3&lt;/b&gt;&lt;br&gt;Large templates only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="650" y="240" width="170" height="70" as="geometry"/></mxCell><mxCell id="ox" value="&lt;b&gt;Deploy&lt;/b&gt;&lt;br&gt;Creates or updates the stack straight away" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="170" height="90" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;Prints the stack’s outputs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1070" y="100" width="170" height="90" as="geometry"/></mxCell><mxCell id="gap" value="&lt;b&gt;Never stops&lt;/b&gt; to check for manual changes, show a preview, or wait for approval" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="345" width="1220" height="50" as="geometry"/></mxCell><mxCell id="sign" value="&lt;b&gt;Sign-in:&lt;/b&gt; one hop, with a role ARN from a GitHub secret, which is AWSControlTowerExecution in the account." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="412" width="1220" height="40" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="os" target="of"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="of" target="od"><mxGeometry relative="1" as="ge